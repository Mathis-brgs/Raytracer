{
  "name": "Raytracer (C++)",
  "build": { "dockerfile": "Dockerfile" },
  "postCreateCommand": "cmake -S . -B build -G Ninja",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cmake-tools",
        "ms-vscode.cpptools"
      ],
      "settings": {
        "C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",
        "cmake.generator": "Ninja",
        "cmake.configureOnOpen": true
      }
    }
  }
}
